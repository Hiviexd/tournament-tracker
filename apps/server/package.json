{
    "name": "@tc/server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "cross-env NODE_ENV=development tsx watch --tsconfig tsconfig.json app.ts",
        "dev:preview": "cross-env NODE_ENV=preview tsx watch --tsconfig tsconfig.json app.ts",
        "build": "tsup",
        "start": "node dist/app.js",
        "migrate": "tsx --tsconfig tsconfig.json migrate.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.995.0",
        "@tc/config": "workspace:*",
        "@tc/types": "workspace:*",
        "@tc/utils": "workspace:*",
        "archiver": "^7.0.1",
        "axios": "^1.13.5",
        "connect-mongo": "3.2.0",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "cron": "^4.1.0",
        "cross-env": "^7.0.3",
        "csurf": "^1.11.0",
        "csv-parse": "^5.6.0",
        "dayjs": "^1.11.13",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.18.0",
        "kleur": "^4.1.5",
        "lodash": "^4.17.23",
        "mongoose": "8.18.1",
        "morgan": "^1.10.0",
        "multer": "^2.0.2",
        "path-to-regexp": "^8.2.0",
        "sharp": "^0.33.5",
        "slugify": "^1.6.6"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.19",
        "@types/csurf": "^1.11.3",
        "@types/express": "^4.17.21",
        "@types/express-session": "^1.18.0",
        "@types/lodash": "^4.17.17",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.12",
        "@types/node": "^24.1.0",
        "@vitest/ui": "3.2.4",
        "glob": "^13.0.6",
        "tsup": "^8.5.0",
        "tsx": "^4.19.4",
        "typescript": "^5.2.2",
        "vitest": "3.2.4"
    }
}
