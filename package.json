{
    "name": "tournament-tracker",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@10.17.1",
    "scripts": {
        "dev": "pnpm run --parallel --filter @tc/server --filter @tc/client dev",
        "dev:automation": "pnpm run --parallel --filter @tc/server --filter @tc/client --filter @tc/jobs dev:automation",
        "dev-client": "pnpm --filter @tc/client dev",
        "dev-server": "pnpm --filter @tc/server dev",
        "dev-jobs": "pnpm --filter @tc/jobs dev",
        "preview-dev": "pnpm run --parallel --filter @tc/server --filter @tc/client --filter @tc/jobs dev:preview",
        "preview-dev-client": "pnpm --filter @tc/client dev:preview",
        "preview-dev-server": "pnpm --filter @tc/server dev:preview",
        "preview-dev-jobs": "pnpm --filter @tc/jobs dev:preview",
        "preview": "cross-env NODE_ENV=preview PORT=8089 SERVE_CLIENT=true pnpm --filter @tc/server start",
        "prod": "cross-env NODE_ENV=production PORT=8088 SERVE_CLIENT=true pnpm --filter @tc/server start",
        "build": "pnpm build-client && pnpm build-server && pnpm build-jobs",
        "build-preview": "pnpm build-client-preview && pnpm build-server && pnpm build-jobs",
        "build-client": "pnpm --filter @tc/client build",
        "build-client-preview": "pnpm --filter @tc/client build:preview",
        "build-server": "pnpm --filter @tc/server build",
        "build-jobs": "pnpm --filter @tc/jobs build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "tsc": "pnpm --filter @tc/server typecheck",
        "typecheck": "pnpm -r run typecheck",
        "test": "pnpm --filter @tc/server test",
        "test:run": "pnpm --filter @tc/server test:run",
        "test:ui": "pnpm --filter @tc/server test:ui",
        "test:coverage": "pnpm --filter @tc/server test:coverage",
        "migrate": "pnpm --filter @tc/migrate run migrate --",
        "format": "prettier --write \"**/*.{ts,tsx,json,scss}\"",
        "docker:prod": "docker compose -f docker-compose.prod.yml -f docker-compose.prod.build.yml up --build -d",
        "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
        "docker:preview": "docker compose -f docker-compose.preview.yml -f docker-compose.preview.build.yml up --build -d",
        "docker:preview:down": "docker compose -f docker-compose.preview.yml down"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@typescript-eslint/parser": "^7.2.0",
        "cross-env": "^7.0.3",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "eslint-plugin-react-you-might-not-need-an-effect": "^0.5.1",
        "prettier": "^3.5.3",
        "typescript": "^5.2.2"
    }
}
