{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "ES2021.Intl", "ES2023.Array"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true
    }
}
