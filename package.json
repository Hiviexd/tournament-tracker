{
    "name": "tournament-tracker",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "run-p -rl dev-server dev-client",
        "dev:automation": "cross-env AUTOMATION_DEBUG=true run-p -rl dev-server dev-client",
        "dev-client": "cross-env NODE_ENV=development vite --mode development",
        "dev-server": "cross-env NODE_ENV=development tsx watch --tsconfig server/tsconfig.json server/app.ts",
        "preview-dev": "run-p -rl preview-dev-client preview-dev-server",
        "preview-dev-client": "cross-env NODE_ENV=preview vite --mode preview",
        "preview-dev-server": "cross-env NODE_ENV=preview tsx watch --tsconfig server/tsconfig.json server/app.ts",
        "preview": "cross-env NODE_ENV=preview PORT=8089 node ./dist/server/app.js",
        "prod": "cross-env NODE_ENV=production PORT=8088 node ./dist/server/app.js",
        "build": "pnpm build-client && pnpm build-server",
        "build-preview": "pnpm build-client-preview && pnpm build-server",
        "build-client": "vite build",
        "build-client-preview": "vite build --mode preview",
        "build-server": "tsup",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "tsc": "tsc --noEmit true --project server/tsconfig.json",
        "test": "cd server && vitest",
        "test:run": "cd server && vitest run",
        "test:ui": "cd server && vitest --ui",
        "test:coverage": "cd server && vitest run --coverage",
        "migrate": "tsx --tsconfig server/tsconfig.json server/migrate.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.995.0",
        "@fortawesome/fontawesome-svg-core": "^6.6.0",
        "@fortawesome/free-brands-svg-icons": "^6.6.0",
        "@fortawesome/free-solid-svg-icons": "^6.6.0",
        "@fortawesome/react-fontawesome": "^0.2.2",
        "@mantine/carousel": "^9.0.2",
        "@mantine/charts": "^8.3.0",
        "@mantine/colors-generator": "^8.1.3",
        "@mantine/core": "^8.1.3",
        "@mantine/dates": "^8.1.3",
        "@mantine/form": "^8.1.3",
        "@mantine/hooks": "^8.1.3",
        "@mantine/modals": "^8.2.8",
        "@mantine/notifications": "^8.1.3",
        "@mantine/spotlight": "^8.3.1",
        "@tanstack/react-query": "^5.51.21",
        "@types/cors": "^2.8.19",
        "archiver": "^7.0.1",
        "axios": "^1.13.5",
        "chroma-js": "^3.1.2",
        "connect-mongo": "3.2.0",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "cron": "^4.1.0",
        "cross-env": "^7.0.3",
        "csurf": "^1.11.0",
        "dayjs": "^1.11.13",
        "embla-carousel": "^8.5.2",
        "embla-carousel-react": "^8.5.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.18.0",
        "jotai": "^2.18.0",
        "kleur": "^4.1.5",
        "lodash": "^4.17.23",
        "mongoose": "8.18.1",
        "morgan": "^1.10.0",
        "multer": "^2.0.2",
        "nuqs": "^2.4.3",
        "path-to-regexp": "^8.2.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-dropzone": "^14.3.8",
        "react-helmet-async": "^2.0.5",
        "react-markdown": "^10.1.0",
        "react-markdown-editor-lite": "^1.3.4",
        "react-router": "^7.13.0",
        "react-router-dom": "^7.13.0",
        "react-snow-overlay": "^1.0.12",
        "recharts": "^3.2.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "rehype-slug": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.0",
        "sharp": "^0.33.5",
        "slugify": "^1.6.6",
        "unist-util-visit": "^5.0.0"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.7",
        "@types/csurf": "^1.11.3",
        "@types/express": "^4.17.21",
        "@types/express-session": "^1.18.0",
        "@types/lodash": "^4.17.17",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.12",
        "@types/node": "^24.1.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@typescript-eslint/parser": "^7.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitest/ui": "3.2.4",
        "babel-plugin-react-compiler": "^1.0.0",
        "country-flag-icons": "^1.5.18",
        "csv-parse": "^5.6.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "eslint-plugin-react-you-might-not-need-an-effect": "^0.5.1",
        "glob": "^13.0.6",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.38",
        "postcss-preset-mantine": "^1.15.0",
        "postcss-simple-vars": "^7.0.1",
        "sass": "^1.92.1",
        "tsup": "^8.5.0",
        "tsx": "^4.19.4",
        "typescript": "^5.2.2",
        "vite": "^5.2.0",
        "vitest": "3.2.4"
    },
    "packageManager": "pnpm@10.17.1"
}
