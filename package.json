{
    "name": "tournament-tracker",
    "private": true,
    "version": "0.0.0",
    "scripts": {
        "dev": "run-p -rl dev-server dev-client",
        "dev-automation": "cross-env AUTOMATION_DEBUG=true run-p -rl dev-server dev-client",
        "dev-client": "cross-env NODE_ENV=development vite --mode development",
        "dev-server": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only --no-notify --project server/tsconfig.json server/app.ts",
        "prod": "cross-env NODE_ENV=production PORT=8088 node ./dist/server/app.js",
        "build": "yarn build-client && yarn build-server",
        "build-client": "vite build",
        "build-server": "cross-env NODE_ENV=production tsc --project server/tsconfig.json",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "tsc": "tsc --noEmit true --project server/tsconfig.json"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.750.0",
        "@fortawesome/fontawesome-svg-core": "^6.6.0",
        "@fortawesome/free-brands-svg-icons": "^6.6.0",
        "@fortawesome/free-solid-svg-icons": "^6.6.0",
        "@fortawesome/react-fontawesome": "^0.2.2",
        "@mantine/colors-generator": "^7.15.2",
        "@mantine/core": "^7.17.1",
        "@mantine/dates": "^7.16.0",
        "@mantine/form": "^7.9.0",
        "@mantine/hooks": "^7.17.1",
        "@mantine/notifications": "^7.11.2",
        "@mantine/tiptap": "^7.17.1",
        "@tabler/icons-react": "^3.3.0",
        "@tanstack/react-query": "^5.51.21",
        "@tiptap/extension-link": "^2.11.5",
        "@tiptap/extension-placeholder": "^2.11.5",
        "@tiptap/pm": "^2.11.5",
        "@tiptap/react": "^2.11.5",
        "@tiptap/starter-kit": "^2.11.5",
        "axios": "^1.6.8",
        "chroma-js": "^3.1.2",
        "connect-mongo": "3.2.0",
        "cookie-parser": "^1.4.6",
        "cron": "^4.1.0",
        "cross-env": "^7.0.3",
        "dayjs": "^1.11.13",
        "express": "^4.19.2",
        "express-session": "^1.18.0",
        "jotai": "^2.8.0",
        "kleur": "^4.1.5",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "mongoose": "5.13.15",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "path-to-regexp": "^8.2.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-helmet-async": "^2.0.5",
        "react-markdown": "^9.0.1",
        "react-router": "^6.23.0",
        "react-router-dom": "^6.23.0",
        "rehype-raw": "^7.0.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.0",
        "slugify": "^1.6.6",
        "tiptap-markdown": "^0.8.10"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.7",
        "@types/express": "^4.17.21",
        "@types/express-session": "^1.18.0",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.12",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@typescript-eslint/parser": "^7.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^8.57.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "express-async-errors": "^3.1.1",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.38",
        "postcss-preset-mantine": "^1.15.0",
        "postcss-simple-vars": "^7.0.1",
        "sass": "^1.76.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.2.2",
        "vite": "^5.2.0"
    },
    "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
