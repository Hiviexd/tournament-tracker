{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "es2020",
        "lib": ["ES2020", "ES2023.Array"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "outDir": "../../dist/server",
        "noEmit": true,
        "types": ["node"],
        "paths": {
            "@controllers/*": ["./controllers/*"],
            "@routers/*": ["./routers/*"],
            "@models/*": ["./models/*"],
            "@helpers/*": ["./helpers/*"],
            "@middlewares/*": ["./middlewares/*"],
            "@services/*": ["./services/*"]
        }
    },
    "include": ["./**/*.ts", "../../packages/types/express.d.ts"],
    "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
